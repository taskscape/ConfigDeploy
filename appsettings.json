{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConfigDeploy": {
    "CacheDirectory": "C:\\ProgramData\\ConfigDeploy\\cache",
    "PollIntervalSeconds": 60,
    "GitTimeoutSeconds": 300,
    "Repositories": [
      {
        "Name": "Example public repository",
        "RepositoryUrl": "https://github.com/example/configuration.git",
        "Branch": "main",
        "DestinationPath": "C:\\Deployments\\configuration-main",
        "RedeployWhenCommitUnchanged": true,
        "Enabled": false
      },
      {
        "Name": "Example private repository with token from environment",
        "RepositoryUrl": "https://github.com/example/private-configuration.git",
        "Branch": "release",
        "DestinationPath": "C:\\Deployments\\configuration-release",
        "RedeployWhenCommitUnchanged": true,
        "Enabled": false,
        "Credentials": {
          "Username": "git",
          "PersonalAccessTokenEnvironmentVariable": "CONFIGDEPLOY_EXAMPLE_PAT"
        }
      }
    ]
  }
}
